# Copy to .env on the server. Never commit .env.
DOMAIN=ops.heroez.example            # public HTTPS hostname pointing at the server
META_APP_SECRET=                     # Meta app > App settings > Basic > App secret
META_VERIFY_TOKEN=                   # any long random string; also typed into Meta's webhook settings
TELEGRAM_BOT_TOKEN=                  # from @BotFather
TELEGRAM_WEBHOOK_SECRET=             # any long random string (letters/digits)
