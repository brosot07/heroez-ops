# Heroez Ops secrets for the Linux/Docker version.
# Copy to .env on the server, fill in, then:  chmod 600 .env
# Never commit .env, never send it in chat or email. The Windows version does not use this
# file: there you type the same values into the settings page (they are stored encrypted).
#
# Make a random value for the "any long random string" lines with:
#   openssl rand -hex 24

# --- Public address ------------------------------------------------------------
DOMAIN=ops.heroez.example            # public HTTPS hostname pointing at the server (Caddy gets the certificate)

# --- Meta / WhatsApp (docs/SETUP_RUNBOOK.md) -------------------------------------
META_APP_SECRET=                     # Meta app > App settings > Basic > App secret  (required)
META_VERIFY_TOKEN=                   # any long random string; type the same into Meta's webhook settings  (required)
META_ACCESS_TOKEN=                   # System user permanent token; only needed for bot replies (Phase 2)

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                  # from @BotFather  (required)
TELEGRAM_WEBHOOK_SECRET=             # any long random string (letters/digits)

# --- AI (Claude) -----------------------------------------------------------------
ANTHROPIC_API_KEY=                   # console.anthropic.com > API keys; without it the word rules alone decide

# --- Optional ---------------------------------------------------------------------
URLHAUS_AUTH_KEY=                    # free at auth.abuse.ch; extra malicious-link check (links are never opened)
DEALS_SHEET_TOKEN=                   # the TOKEN you set in docs/deals_sheet.gs (deal pipeline -> Google Sheet)
# LOG_LEVEL=INFO
