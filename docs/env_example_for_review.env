# =====================================================================================
#  Heroez Ops — EXAMPLE .env FOR REVIEW ONLY.  ALL VALUES BELOW ARE FAKE.
#  Same keys, formats and lengths as the real file; none of these work anywhere.
#  The real file is created on the server from .env.example, filled with the keys from
#  each service's own dashboard, kept at chmod 600, and never committed or shared.
# =====================================================================================

# Public HTTPS hostname of the server. Caddy obtains its certificate automatically.
DOMAIN=ops.heroez.example

# --- Meta / WhatsApp Cloud API -------------------------------------------------------
# Verifies the HMAC-SHA256 signature (X-Hub-Signature-256) of every webhook from Meta.
# Requests with a bad signature are rejected.  [sources/meta.py via service.py:45]
META_APP_SECRET=FAKE0123456789abcdef0123456789ab

# Chosen by us; Meta echoes it once when the webhook URL is registered.  [app.py, config.py:323]
META_VERIFY_TOKEN=FAKE-3f9c1a7e5b2d48c6a0e1f7b9d2c4e8a1b3d5f7

# System-user token used ONLY to send bot replies (Phase 2). Empty = the bot can't send.
# Scopes: whatsapp_business_messaging, whatsapp_business_management.  [sources/meta_send.py via service.py:68]
META_ACCESS_TOKEN=FAKE_EAAGm0PX4ZCpsBAFAKEFAKEFAKEZBxZAZCvL3kQ9wFAKEFAKEZDZD

# --- Telegram --------------------------------------------------------------------------
# Bot token from @BotFather. Sends reminders and reads button presses.  [alerts/telegram.py via service.py:52]
TELEGRAM_BOT_TOKEN=0000000000:FAKE-AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Checked against Telegram's X-Telegram-Bot-Api-Secret-Token header (webhook mode only;
# the default polling mode does not use it).  [app.py:99, constant-time compare]
TELEGRAM_WEBHOOK_SECRET=FAKE8d2f6a1c9e4b7d3f0a5c8e2b6d9f1a4c7e0b3

# --- AI (Anthropic Claude API) -----------------------------------------------------------
# Message check, bot understanding, reply drafts, template/document reading.
# Billing is per use; the app caps calls per day.  [ai.py, concierge_ai.py, drafts.py, contract_ai.py, doc_import.py]
ANTHROPIC_API_KEY=sk-ant-api03-FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE-FAKEAA

# --- Optional --------------------------------------------------------------------------------
# abuse.ch URLhaus lookup by URL only (links are never opened).  [links.py via service.py:63]
URLHAUS_AUTH_KEY=FAKEa1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2

# Shared secret sent with each deal-pipeline push to our own Google Apps Script (docs/deals_sheet.gs),
# which rejects requests without it. Only script.google.com URLs are accepted.  [deals.py:209]
DEALS_SHEET_TOKEN=FAKE-5e8b2d7a4c1f9e6b3a0d8c5f2e9b6a3d0c7f4e1

# LOG_LEVEL=INFO
